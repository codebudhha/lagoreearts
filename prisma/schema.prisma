// ==========================================
// MODULE 15: NAVIGATION / MENUS
// ==========================================

enum NavigationLocation {
  HEADER
  FOOTER
  MOBILE
  SECONDARY
}

enum NavigationStatus {
  ACTIVE
  INACTIVE
}

enum NavigationItemTargetType {
  NONE
  CATEGORY
  COLLECTION
  PRODUCT
  ARTIST
  JOURNAL
  LOOKBOOK
  SANSKRIT_EDIT
  INTERNAL_URL
  EXTERNAL_URL
}

enum NavigationItemDisplayType {
  LINK
  GROUP
  MEGA_MENU
}

model Navigation {
  id        String             @id @default(uuid()) @db.VarChar(36)
  name      String             @db.VarChar(255)
  slug      String             @unique @db.VarChar(255)
  location  NavigationLocation @default(HEADER)
  status    NavigationStatus   @default(ACTIVE)
  isDefault Boolean            @default(false) @map("is_default")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  items     NavigationItem[]

  @@index([location])
  @@index([status])
  @@index([isDefault])
  @@map("navigations")
}

model NavigationItem {
  id           String                    @id @default(uuid()) @db.VarChar(36)
  navigationId String                    @map("navigation_id") @db.VarChar(36)
  parentId     String?                   @map("parent_id") @db.VarChar(36)
  label        String                    @db.VarChar(255)
  description  String?                   @db.Text
  targetType   NavigationItemTargetType  @default(NONE) @map("target_type")
  targetId     String?                   @map("target_id") @db.VarChar(36)
  url          String?                   @db.VarChar(1024)
  displayType  NavigationItemDisplayType @default(LINK) @map("display_type")
  openInNewTab Boolean                   @default(false) @map("open_in_new_tab")
  isVisible    Boolean                   @default(true) @map("is_visible")
  isFeatured   Boolean                   @default(false) @map("is_featured")
  sortOrder    Int                       @default(0) @map("sort_order")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  navigation   Navigation                @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parent       NavigationItem?           @relation("NavigationItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[]          @relation("NavigationItemHierarchy")

  @@index([navigationId])
  @@index([parentId])
  @@index([targetType])
  @@index([targetId])
  @@index([sortOrder])
  @@index([isVisible])
  @@map("navigation_items")
}

// ==========================================
// MODULE 16: CUSTOMER IDENTITY & ACCOUNTS
// ==========================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Customer {
  id                 String                     @id @default(uuid()) @db.VarChar(36)
  email              String                     @db.VarChar(255)
  normalizedEmail    String                     @unique @map("normalized_email") @db.VarChar(255)
  passwordHash       String                     @map("password_hash") @db.VarChar(255)
  firstName          String                     @map("first_name") @db.VarChar(100)
  lastName           String                     @map("last_name") @db.VarChar(100)
  phone              String?                    @db.VarChar(50)
  status             CustomerStatus             @default(ACTIVE)
  emailVerifiedAt    DateTime?                  @map("email_verified_at")
  lastLoginAt        DateTime?                  @map("last_login_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  sessions           CustomerSession[]
  addresses          CustomerAddress[]
  passwordResets     CustomerPasswordReset[]
  emailVerifications CustomerEmailVerification[]
  cart               Cart?
  checkoutSessions   CheckoutSession[]
  orders             Order[]

  @@index([normalizedEmail])
  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

model CustomerSession {
  id               String    @id @default(uuid()) @db.VarChar(36)
  customerId       String    @map("customer_id") @db.VarChar(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)

  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model CustomerPasswordReset {
  id         String    @id @default(uuid()) @db.VarChar(36)
  customerId String    @map("customer_id") @db.VarChar(36)
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("customer_password_resets")
}

model CustomerEmailVerification {
  id         String    @id @default(uuid()) @db.VarChar(36)
  customerId String    @map("customer_id") @db.VarChar(36)
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("customer_email_verifications")
}

model CustomerAddress {
  id                String      @id @default(uuid()) @db.VarChar(36)
  customerId        String      @map("customer_id") @db.VarChar(36)
  type              AddressType @default(HOME)
  firstName         String      @map("first_name") @db.VarChar(100)
  lastName          String      @map("last_name") @db.VarChar(100)
  companyName       String?     @map("company_name") @db.VarChar(255)
  addressLine1      String      @map("address_line1") @db.VarChar(255)
  addressLine2      String?     @map("address_line2") @db.VarChar(255)
  landmark          String?     @db.VarChar(255)
  city              String      @db.VarChar(100)
  state             String      @db.VarChar(100)
  postalCode        String      @map("postal_code") @db.VarChar(20)
  country           String      @default("INDIA") @db.VarChar(100)
  phone             String      @db.VarChar(50)
  isDefaultShipping Boolean     @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean     @default(false) @map("is_default_billing")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isDefaultShipping])
  @@index([isDefaultBilling])
  @@map("customer_addresses")
}

model Cart {
  id             String     @id @default(uuid()) @db.VarChar(36)
  customerId     String?    @unique @map("customer_id") @db.VarChar(36)
  guestTokenHash String?    @unique @map("guest_token_hash") @db.VarChar(255)
  currency       String     @default("INR") @db.VarChar(10)
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  checkouts      CheckoutSession[]

  @@index([customerId])
  @@index([guestTokenHash])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id                String          @id @default(uuid()) @db.VarChar(36)
  cartId            String          @map("cart_id") @db.VarChar(36)
  productId         String          @map("product_id") @db.VarChar(36)
  variantId         String?         @map("variant_id") @db.VarChar(36)
  quantity          Int             @default(1)
  lastSeenUnitPrice Decimal?        @map("last_seen_unit_price") @db.Decimal(12, 2)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

enum CheckoutStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum CheckoutAddressType {
  SHIPPING
  BILLING
}

model CheckoutSession {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  customerId         String?           @map("customer_id") @db.VarChar(36)
  cartId             String            @map("cart_id") @db.VarChar(36)
  guestTokenHash     String?           @map("guest_token_hash") @db.VarChar(255)
  status             CheckoutStatus    @default(ACTIVE)
  currency           String            @default("INR") @db.VarChar(10)
  email              String            @db.VarChar(255)
  billingAddressId   String?           @map("billing_address_id") @db.VarChar(36)
  shippingAddressId  String?           @map("shipping_address_id") @db.VarChar(36)
  subtotal           Decimal           @db.Decimal(12, 2)
  discountTotal      Decimal           @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal      Decimal           @default(0.00) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal           @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  grandTotal         Decimal           @map("grand_total") @db.Decimal(12, 2)
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(255)
  expiresAt          DateTime          @map("expires_at")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cart               Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  items              CheckoutItem[]
  addresses          CheckoutAddress[]
  order              Order?

  @@index([customerId])
  @@index([cartId])
  @@index([guestTokenHash])
  @@index([status])
  @@index([expiresAt])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("checkout_sessions")
}

model CheckoutItem {
  id                 String          @id @default(uuid()) @db.VarChar(36)
  checkoutSessionId  String          @map("checkout_session_id") @db.VarChar(36)
  productId          String          @map("product_id") @db.VarChar(36)
  variantId          String?         @map("variant_id") @db.VarChar(36)
  sku                String          @db.VarChar(100)
  productName        String          @map("product_name") @db.VarChar(255)
  variantDescription String?         @map("variant_description") @db.VarChar(255)
  quantity           Int             @default(1)
  unitPrice          Decimal         @map("unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal         @map("line_total") @db.Decimal(12, 2)
  currency           String          @default("INR") @db.VarChar(10)
  createdAt          DateTime        @default(now()) @map("created_at")

  checkoutSession    CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([checkoutSessionId])
  @@index([productId])
  @@index([variantId])
  @@map("checkout_items")
}

model CheckoutAddress {
  id                String              @id @default(uuid()) @db.VarChar(36)
  checkoutSessionId String              @map("checkout_session_id") @db.VarChar(36)
  type              CheckoutAddressType @default(SHIPPING)
  firstName         String              @map("first_name") @db.VarChar(100)
  lastName          String              @map("last_name") @db.VarChar(100)
  companyName       String?             @map("company_name") @db.VarChar(255)
  addressLine1      String              @map("address_line1") @db.VarChar(255)
  addressLine2      String?             @map("address_line2") @db.VarChar(255)
  landmark          String?             @db.VarChar(255)
  city              String              @db.VarChar(100)
  state             String              @db.VarChar(100)
  postalCode        String              @map("postal_code") @db.VarChar(20)
  country           String              @default("INDIA") @db.VarChar(100)
  phone             String              @db.VarChar(50)
  createdAt         DateTime            @default(now()) @map("created_at")

  checkoutSession   CheckoutSession     @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([checkoutSessionId])
  @@index([type])
  @@map("checkout_addresses")
}

// ==========================================
// MODULE 20 — ORDERS
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

model Order {
  id                 String           @id @default(uuid()) @db.VarChar(36)
  orderNumber        String           @unique @map("order_number") @db.VarChar(50)
  customerId         String?          @map("customer_id") @db.VarChar(36)
  checkoutSessionId  String           @unique @map("checkout_session_id") @db.VarChar(36)
  guestOrderTokenHash String?         @map("guest_order_token_hash") @db.VarChar(255)
  currency           String           @default("INR") @db.VarChar(10)
  status             OrderStatus      @default(PENDING)
  paymentStatus      PaymentStatus    @default(PENDING) @map("payment_status")
  email              String           @db.VarChar(255)
  subtotal           Decimal          @db.Decimal(12, 2)
  discountTotal      Decimal          @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal      Decimal          @default(0.00) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal          @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  grandTotal         Decimal          @map("grand_total") @db.Decimal(12, 2)
  notes              String?          @db.Text
  placedAt           DateTime         @default(now()) @map("placed_at")
  confirmedAt        DateTime?        @map("confirmed_at")
  shippedAt          DateTime?        @map("shipped_at")
  deliveredAt        DateTime?        @map("delivered_at")
  cancelledAt        DateTime?        @map("cancelled_at")
  cancellationReason String?          @map("cancellation_reason") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  customer           Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  checkoutSession    CheckoutSession  @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  addresses          OrderAddress[]
  payments           Payment[]

  @@index([orderNumber])
  @@index([checkoutSessionId])
  @@index([customerId])
  @@index([guestOrderTokenHash])
  @@index([status])
  @@index([paymentStatus])
  @@index([email])
  @@index([placedAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(uuid()) @db.VarChar(36)
  orderId            String          @map("order_id") @db.VarChar(36)
  productId          String?         @map("product_id") @db.VarChar(36)
  variantId          String?         @map("variant_id") @db.VarChar(36)
  sku                String          @db.VarChar(100)
  productName        String          @map("product_name") @db.VarChar(255)
  variantDescription String?         @map("variant_description") @db.VarChar(255)
  quantity           Int             @default(1)
  unitPrice          Decimal         @map("unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal         @map("line_total") @db.Decimal(12, 2)
  currency           String          @default("INR") @db.VarChar(10)
  createdAt          DateTime        @default(now()) @map("created_at")

  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@map("order_items")
}

model OrderAddress {
  id           String           @id @default(uuid()) @db.VarChar(36)
  orderId      String           @map("order_id") @db.VarChar(36)
  type         OrderAddressType @default(SHIPPING)
  fullName     String           @map("full_name") @db.VarChar(200)
  firstName    String           @map("first_name") @db.VarChar(100)
  lastName     String           @map("last_name") @db.VarChar(100)
  companyName  String?          @map("company_name") @db.VarChar(255)
  addressLine1 String           @map("address_line1") @db.VarChar(255)
  addressLine2 String?          @map("address_line2") @db.VarChar(255)
  landmark     String?          @db.VarChar(255)
  city         String           @db.VarChar(100)
  state        String           @db.VarChar(100)
  postalCode   String           @map("postal_code") @db.VarChar(20)
  country      String           @default("INDIA") @db.VarChar(100)
  phone        String           @db.VarChar(50)
  createdAt    DateTime         @default(now()) @map("created_at")

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@map("order_addresses")
}

model OrderSequence {
  id            String   @id @default("ORDER_SEQ_DEFAULT") @db.VarChar(50)
  year          Int
  currentNumber Int      @default(0) @map("current_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([year])
  @@map("order_sequences")
}

// ==========================================
// MODULE 21 — PAYMENTS
// ==========================================

enum PaymentRecordStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String              @id @default(uuid()) @db.VarChar(36)
  orderId           String              @map("order_id") @db.VarChar(36)
  provider          String              @default("RAZORPAY") @db.VarChar(50)
  providerPaymentId String?             @map("provider_payment_id") @db.VarChar(100)
  providerOrderId   String?             @map("provider_order_id") @db.VarChar(100)
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR") @db.VarChar(10)
  status            PaymentRecordStatus @default(CREATED)
  method            String?             @db.VarChar(50)
  idempotencyKey    String?             @map("idempotency_key") @db.VarChar(255)
  failureCode       String?             @map("failure_code") @db.VarChar(100)
  failureMessage    String?             @map("failure_message") @db.Text
  paidAt            DateTime?           @map("paid_at")
  failedAt          DateTime?           @map("failed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts          PaymentAttempt[]
  refunds           PaymentRefund[]

  @@index([orderId])
  @@index([provider])
  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  paymentId            String   @map("payment_id") @db.VarChar(36)
  provider             String   @db.VarChar(50)
  providerOrderId      String?  @map("provider_order_id") @db.VarChar(100)
  providerPaymentId    String?  @map("provider_payment_id") @db.VarChar(100)
  amount               Decimal  @db.Decimal(12, 2)
  currency             String   @default("INR") @db.VarChar(10)
  status               String   @db.VarChar(50)
  idempotencyKey       String?  @map("idempotency_key") @db.VarChar(255)
  requestReference     String?  @map("request_reference") @db.VarChar(255)
  failureCode          String?  @map("failure_code") @db.VarChar(100)
  failureMessage       String?  @map("failure_message") @db.Text
  rawResponseSanitized String?  @map("raw_response_sanitized") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.VarChar(36)
  provider          String    @db.VarChar(50)
  eventId           String    @map("event_id") @db.VarChar(100)
  eventType         String    @map("event_type") @db.VarChar(100)
  signatureVerified Boolean   @default(false) @map("signature_verified")
  payloadHash       String    @map("payload_hash") @db.VarChar(255)
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider])
  @@index([eventType])
  @@index([payloadHash])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

model PaymentRefund {
  id               String    @id @default(uuid()) @db.VarChar(36)
  paymentId        String    @map("payment_id") @db.VarChar(36)
  providerRefundId String?   @map("provider_refund_id") @db.VarChar(100)
  amount           Decimal   @db.Decimal(12, 2)
  currency         String    @default("INR") @db.VarChar(10)
  status           String    @default("PENDING") @db.VarChar(50)
  reason           String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([providerRefundId])
  @@index([status])
  @@map("payment_refunds")
}




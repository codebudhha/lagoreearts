datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum AttributeType {
  TEXT
  SELECT
  MULTI_SELECT
  BOOLEAN
  NUMBER
  RANGE
}

enum AttributeStatus {
  ACTIVE
  INACTIVE
}

enum CollectionStatus {
  ACTIVE
  INACTIVE
}

enum CollectionType {
  MANUAL
  SYSTEM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
}

enum MediaRole {
  PRIMARY
  GALLERY
  THUMBNAIL
  BANNER
  OG
}

enum AntiqueCondition {
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  POOR
  RESTORED
  FOR_RESTORATION
}

enum AntiqueRestorationStatus {
  ORIGINAL
  PARTIALLY_RESTORED
  FULLY_RESTORED
  UNKNOWN
}

enum AntiqueAuthenticityStatus {
  UNKNOWN
  UNVERIFIED
  VERIFIED
}

enum DimensionUnit {
  MM
  CM
  M
  IN
  FT
}

enum ArtistStatus {
  ACTIVE
  INACTIVE
}

enum ArtistRole {
  ARTIST
  MAKER
  DESIGNER
  ATTRIBUTED_TO
}

enum ArtistMediaRole {
  PROFILE
  GALLERY
  OG
}

enum WeightUnit {
  G
  KG
  OZ
  LB
}

enum HomepageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomepageSectionType {
  HERO
  FEATURED_COLLECTIONS
  FEATURED_PRODUCTS
  FEATURED_ARTISTS
  CATEGORIES
  ANTIQUES
  SANSKRIT_EDIT
  EDITORIAL
  IMAGE_BANNER
  PROMOTIONAL_BANNER
  SPACER
}

enum HomepageSectionMediaRole {
  PRIMARY
  MOBILE
  BACKGROUND
  GALLERY
}

enum JournalPostType {
  ARTICLE
  ESSAY
  INTERVIEW
  STORY
  GUIDE
  NEWS
}

enum JournalPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JournalAuthorStatus {
  ACTIVE
  INACTIVE
}

enum JournalCategoryStatus {
  ACTIVE
  INACTIVE
}

enum JournalTagStatus {
  ACTIVE
  INACTIVE
}

enum JournalPostMediaRole {
  COVER
  GALLERY
  OG
}

model AdminUser {
  id                String       @id @default(uuid()) @db.VarChar(36)
  name              String       @db.VarChar(191)
  email             String       @unique @db.VarChar(191)
  passwordHash      String       @map("password_hash") @db.VarChar(255)
  status            AdminStatus  @default(ACTIVE)
  roleId            String       @map("role_id") @db.VarChar(36)
  lastLoginAt       DateTime?    @map("last_login_at")
  passwordChangedAt DateTime?    @map("password_changed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  role              Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions          AdminSession[]
  passwordResets    AdminPasswordReset[]
  auditLogs         AdminAuditLog[]

  @@index([email])
  @@index([status])
  @@index([roleId])
  @@map("admin_users")
}

model Role {
  id          String           @id @default(uuid()) @db.VarChar(36)
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  adminUsers  AdminUser[]
  permissions RolePermission[]

  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  name        String           @db.VarChar(150)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.Text
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  roles       RolePermission[]

  @@index([slug])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminSession {
  id               String     @id @default(uuid()) @db.VarChar(36)
  adminUserId      String     @map("admin_user_id") @db.VarChar(36)
  refreshTokenHash String     @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?    @map("user_agent") @db.Text
  ipAddress        String?    @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime   @map("expires_at")
  revokedAt        DateTime?  @map("revoked_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  lastUsedAt       DateTime   @default(now()) @map("last_used_at")

  adminUser        AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminPasswordReset {
  id          String    @id @default(uuid()) @db.VarChar(36)
  adminUserId String    @map("admin_user_id") @db.VarChar(36)
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([tokenHash])
  @@map("admin_password_resets")
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.VarChar(36)
  adminUserId String?   @map("admin_user_id") @db.VarChar(36)
  action      String    @db.VarChar(100)
  module      String    @db.VarChar(50)
  entityType  String?   @map("entity_type") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.VarChar(36)
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Category {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  name               String              @db.VarChar(100)
  slug               String              @unique @db.VarChar(120)
  parentId           String?             @map("parent_id") @db.VarChar(36)
  shortDescription   String?             @map("short_description") @db.VarChar(255)
  description        String?             @db.Text
  image              String?             @db.VarChar(255)
  imageAlt           String?             @map("image_alt") @db.VarChar(150)
  bannerImage        String?             @map("banner_image") @db.VarChar(255)
  bannerImageAlt     String?             @map("banner_image_alt") @db.VarChar(150)
  status             CategoryStatus      @default(ACTIVE)
  isFeatured         Boolean             @default(false) @map("is_featured")
  sortOrder          Int                 @default(0) @map("sort_order")
  metaTitle          String?             @map("meta_title") @db.VarChar(150)
  metaDescription    String?             @map("meta_description") @db.Text
  canonicalUrl       String?             @map("canonical_url") @db.VarChar(255)
  ogTitle            String?             @map("og_title") @db.VarChar(150)
  ogDescription      String?             @map("og_description") @db.Text
  ogImage            String?             @map("og_image") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  parent             Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]          @relation("CategoryHierarchy")
  categoryAttributes CategoryAttribute[]
  products           Product[]
  media              CategoryMedia[]
  homepageSections   HomepageSectionCategory[]
  lookbookSections   LookbookSectionCategory[]

  @@index([slug])
  @@index([status])
  @@index([parentId])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([createdAt])
  @@map("categories")
}

model Attribute {
  id                     String                  @id @default(uuid()) @db.VarChar(36)
  name                   String                  @db.VarChar(100)
  slug                   String                  @unique @db.VarChar(100)
  type                   AttributeType           @default(MULTI_SELECT)
  description            String?                 @db.Text
  status                 AttributeStatus         @default(ACTIVE)
  isFilterable           Boolean                 @default(true) @map("is_filterable")
  isRequired             Boolean                 @default(false) @map("is_required")
  isSystem               Boolean                 @default(false) @map("is_system")
  sortOrder              Int                     @default(0) @map("sort_order")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  values                 AttributeValue[]
  categoryAttributes     CategoryAttribute[]
  productAttributeValues ProductAttributeValue[]

  @@index([slug])
  @@index([status])
  @@index([isFilterable])
  @@index([sortOrder])
  @@map("attributes")
}

model AttributeValue {
  id                     String                  @id @default(uuid()) @db.VarChar(36)
  attributeId            String                  @map("attribute_id") @db.VarChar(36)
  name                   String                  @db.VarChar(100)
  slug                   String                  @db.VarChar(100)
  description            String?                 @db.Text
  sortOrder              Int                     @default(0) @map("sort_order")
  status                 AttributeStatus         @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  attribute              Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributeValues ProductAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@index([slug])
  @@index([status])
  @@index([sortOrder])
  @@map("attribute_values")
}

model CategoryAttribute {
  categoryId  String    @map("category_id") @db.VarChar(36)
  attributeId String    @map("attribute_id") @db.VarChar(36)
  sortOrder   Int       @default(0) @map("sort_order")
  isVisible   Boolean   @default(true) @map("is_visible")
  isRequired  Boolean   @default(false) @map("is_required")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
  @@index([sortOrder])
  @@map("category_attributes")
}

model Collection {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  name               String              @db.VarChar(120)
  slug               String              @unique @db.VarChar(140)
  shortDescription   String?             @map("short_description") @db.VarChar(255)
  description        String?             @db.Text
  image              String?             @db.VarChar(255)
  bannerImage        String?             @map("banner_image") @db.VarChar(255)
  heroTitle          String?             @map("hero_title") @db.VarChar(150)
  heroDescription    String?             @map("hero_description") @db.Text
  status             CollectionStatus    @default(ACTIVE)
  type               CollectionType      @default(MANUAL)
  isFeatured         Boolean             @default(false) @map("is_featured")
  sortOrder          Int                 @default(0) @map("sort_order")
  metaTitle          String?             @map("meta_title") @db.VarChar(150)
  metaDescription    String?             @map("meta_description") @db.Text
  canonicalUrl       String?             @map("canonical_url") @db.VarChar(255)
  ogTitle            String?             @map("og_title") @db.VarChar(150)
  ogDescription      String?             @map("og_description") @db.Text
  ogImage            String?             @map("og_image") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  productCollections ProductCollection[]
  media              CollectionMedia[]
  homepageSections   HomepageSectionCollection[]
  journalPosts       JournalPostCollection[]
  lookbookSections   LookbookSectionCollection[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([createdAt])
  @@map("collections")
}

model Product {
  id                String                  @id @default(uuid()) @db.VarChar(36)
  name              String                  @db.VarChar(150)
  slug              String                  @unique @db.VarChar(180)
  sku               String                  @unique @db.VarChar(80)
  shortDescription  String?                 @map("short_description") @db.VarChar(255)
  description       String?                 @db.Text
  status            ProductStatus           @default(DRAFT)
  productType       ProductType             @default(SIMPLE) @map("product_type")
  price             Decimal                 @db.Decimal(10, 2)
  compareAtPrice    Decimal?                @map("compare_at_price") @db.Decimal(10, 2)
  costPrice         Decimal?                @map("cost_price") @db.Decimal(10, 2)
  currency          String                  @default("INR") @db.VarChar(3)
  stockQuantity     Int                     @default(0) @map("stock_quantity")
  lowStockThreshold Int                     @default(5) @map("low_stock_threshold")
  trackInventory    Boolean                 @default(true) @map("track_inventory")
  allowBackorder    Boolean                 @default(false) @map("allow_backorder")
  isFeatured        Boolean                 @default(false) @map("is_featured")
  isNewArrival      Boolean                 @default(false) @map("is_new_arrival")
  isBestseller      Boolean                 @default(false) @map("is_bestseller")
  sortOrder         Int                     @default(0) @map("sort_order")
  categoryId        String                  @map("category_id") @db.VarChar(36)
  image             String?                 @db.VarChar(255)
  thumbnail         String?                 @db.VarChar(255)
  bannerImage       String?                 @map("banner_image") @db.VarChar(255)
  metaTitle         String?                 @map("meta_title") @db.VarChar(150)
  metaDescription   String?                 @map("meta_description") @db.Text
  canonicalUrl      String?                 @map("canonical_url") @db.VarChar(255)
  ogTitle           String?                 @map("og_title") @db.VarChar(150)
  ogDescription     String?                 @map("og_description") @db.Text
  ogImage           String?                 @map("og_image") @db.VarChar(255)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  category          Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collections       ProductCollection[]
  attributes        ProductAttributeValue[]
  options           ProductOption[]
  variants          ProductVariant[]
  media             ProductMedia[]
  antiqueProfile    AntiqueProfile?
  sanskritEditProfile SanskritEditProfile?
  artists           ProductArtist[]
  homepageSections  HomepageSectionProduct[]
  journalPosts      JournalPostProduct[]
  lookbookSections  LookbookSectionProduct[]
  cartItems         CartItem[]
  checkoutItems     CheckoutItem[]
  orderItems        OrderItem[]

  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([productType])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestseller])
  @@index([sortOrder])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

model AntiqueProfile {
  id                    String                    @id @default(uuid()) @db.VarChar(36)
  productId             String                    @unique @map("product_id") @db.VarChar(36)
  era                   String?                   @db.VarChar(100)
  period                String?                   @db.VarChar(100)
  approximateAgeFrom    Int?                      @map("approximate_age_from")
  approximateAgeTo      Int?                      @map("approximate_age_to")
  ageDescription        String?                   @map("age_description") @db.VarChar(255)
  origin                String?                   @db.VarChar(150)
  region                String?                   @db.VarChar(100)
  countryOfOrigin       String?                   @map("country_of_origin") @db.VarChar(100)
  artistMaker           String?                   @map("artist_maker") @db.VarChar(150)
  attribution           String?                   @db.VarChar(150)
  schoolOrTradition     String?                   @map("school_or_tradition") @db.VarChar(150)
  material              String?                   @db.VarChar(255)
  technique             String?                   @db.VarChar(255)
  condition             AntiqueCondition?
  conditionNotes        String?                   @map("condition_notes") @db.Text
  restorationStatus     AntiqueRestorationStatus  @default(UNKNOWN) @map("restoration_status")
  restorationNotes      String?                   @map("restoration_notes") @db.Text
  provenance            String?                   @db.Text
  provenanceNotes       String?                   @map("provenance_notes") @db.Text
  authenticityStatus    AntiqueAuthenticityStatus @default(UNKNOWN) @map("authenticity_status")
  authenticityNotes     String?                   @map("authenticity_notes") @db.Text
  acquisitionSource     String?                   @map("acquisition_source") @db.VarChar(255)
  acquisitionNotes      String?                   @map("acquisition_notes") @db.Text
  dimensionsDescription String?                   @map("dimensions_description") @db.VarChar(255)
  height                Decimal?                  @db.Decimal(10, 2)
  width                 Decimal?                  @db.Decimal(10, 2)
  depth                 Decimal?                  @db.Decimal(10, 2)
  diameter              Decimal?                  @db.Decimal(10, 2)
  dimensionUnit         DimensionUnit             @default(CM) @map("dimension_unit")
  weight                Decimal?                  @db.Decimal(10, 2)
  weightUnit            WeightUnit                @default(KG) @map("weight_unit")
  isOneOfAKind          Boolean                   @default(true) @map("is_one_of_a_kind")
  isCertified           Boolean                   @default(false) @map("is_certified")
  certificateNumber     String?                   @map("certificate_number") @db.VarChar(100)
  certificateIssuer     String?                   @map("certificate_issuer") @db.VarChar(150)
  certificateDate       DateTime?                 @map("certificate_date")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  product               Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([era])
  @@index([origin])
  @@index([condition])
  @@index([restorationStatus])
  @@index([authenticityStatus])
  @@index([isOneOfAKind])
  @@index([createdAt])
  @@map("antique_profiles")
}

model SanskritEditProfile {
  id                         String    @id @default(uuid()) @db.VarChar(36)
  productId                  String    @unique @map("product_id") @db.VarChar(36)
  sanskritTitle              String?   @map("sanskrit_title") @db.VarChar(255)
  devanagariText             String?   @map("devanagari_text") @db.Text
  transliteration            String?   @db.Text
  translation                String?   @db.Text
  meaning                    String?   @db.Text
  pronunciation              String?   @db.VarChar(255)
  pronunciationGuide         String?   @map("pronunciation_guide") @db.Text
  source                     String?   @db.VarChar(255)
  sourceReference            String?   @map("source_reference") @db.VarChar(255)
  theme                      String?   @db.VarChar(100)
  context                    String?   @db.Text
  editorialContent           String?   @map("editorial_content") @db.Text
  featuredExcerpt            String?   @map("featured_excerpt") @db.Text
  featuredExcerptTranslation String?   @map("featured_excerpt_translation") @db.Text
  editorialNote              String?   @map("editorial_note") @db.Text
  displayOrder               Int       @default(0) @map("display_order")
  isFeatured                 Boolean   @default(false) @map("is_featured")
  isPublished                Boolean   @default(false) @map("is_published")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  product                    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  journalPosts               JournalPostSanskritEdit[]
  lookbookSections           LookbookSectionSanskritEdit[]

  @@index([productId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([theme])
  @@index([source])
  @@index([createdAt])
  @@map("sanskrit_edit_profiles")
}

model ProductCollection {
  productId    String     @map("product_id") @db.VarChar(36)
  collectionId String     @map("collection_id") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at")

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([productId])
  @@index([collectionId])
  @@map("product_collections")
}

model ProductAttributeValue {
  id               String          @id @default(uuid()) @db.VarChar(36)
  productId        String          @map("product_id") @db.VarChar(36)
  attributeId      String          @map("attribute_id") @db.VarChar(36)
  attributeValueId String?         @map("attribute_value_id") @db.VarChar(36)
  textValue        String?         @map("text_value") @db.Text
  numberValue      Decimal?        @map("number_value") @db.Decimal(10, 2)
  booleanValue     Boolean?        @map("boolean_value")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute        Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
  @@map("product_attribute_values")
}

model ProductOption {
  id          String               @id @default(uuid()) @db.VarChar(36)
  productId   String               @map("product_id") @db.VarChar(36)
  name        String               @db.VarChar(100)
  slug        String               @db.VarChar(100)
  sortOrder   Int                  @default(0) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values      ProductOptionValue[]

  @@unique([productId, slug])
  @@index([productId])
  @@index([sortOrder])
  @@map("product_options")
}

model ProductOptionValue {
  id                  String                      @id @default(uuid()) @db.VarChar(36)
  productOptionId     String                      @map("product_option_id") @db.VarChar(36)
  value               String                      @db.VarChar(100)
  slug                String                      @db.VarChar(100)
  sortOrder           Int                         @default(0) @map("sort_order")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  option              ProductOption               @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  variantOptionValues ProductVariantOptionValue[]

  @@unique([productOptionId, slug])
  @@index([productOptionId])
  @@index([sortOrder])
  @@map("product_option_values")
}

model ProductVariant {
  id                String                      @id @default(uuid()) @db.VarChar(36)
  productId         String                      @map("product_id") @db.VarChar(36)
  sku               String                      @unique @db.VarChar(100)
  price             Decimal?                    @db.Decimal(10, 2)
  compareAtPrice    Decimal?                    @map("compare_at_price") @db.Decimal(10, 2)
  costPrice         Decimal?                    @map("cost_price") @db.Decimal(10, 2)
  stockQuantity     Int                         @default(0) @map("stock_quantity")
  lowStockThreshold Int                         @default(5) @map("low_stock_threshold")
  trackInventory    Boolean                     @default(true) @map("track_inventory")
  allowBackorder    Boolean                     @default(false) @map("allow_backorder")
  status            ProductVariantStatus        @default(ACTIVE)
  image             String?                     @db.VarChar(255)
  sortOrder         Int                         @default(0) @map("sort_order")
  createdAt         DateTime                    @default(now()) @map("created_at")

# Node Environment & Server Port
NODE_ENV=development
PORT=5000

# Database Connection (MySQL / Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/lagoree_arts"

# JWT Authentication Secrets & Lifespans
JWT_ACCESS_SECRET="lagoree_super_secret_access_jwt_key_2026_luxury_arts"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="lagoree_super_secret_refresh_jwt_key_2026_heritage"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Cookie Security Configuration
ADMIN_FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN="localhost"

# Password Reset Expiration
PASSWORD_RESET_EXPIRES_IN="30m"

# Brute-Force Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Mailer Configuration (Placeholders)
EMAIL_FROM="concierge@lagoreearts.com"
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER="placeholder_user"
MAIL_PASSWORD="placeholder_password"
